{
  "name": "planar-studio",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Engine and validation suite for the Planar Studio KiCad extension.",
  "scripts": {
    "test": "node tests/verify.mjs && node tests/motor-layout.mjs && node tests/motor-families.mjs && node tests/design-tools.mjs && node tests/lumped-layout.mjs && node tests/creators.mjs && node tests/creator-families.mjs && node tests/loaded-stack-antennas.mjs && node tests/rpc.mjs && python3 -m unittest discover -s tests -p \"test_*.py\"",
    "test:numerics": "node tests/verify.mjs",
    "test:plugin": "node tests/rpc.mjs",
    "test:ui": "node tests/smoke.mjs",
    "shots": "node tests/shots.mjs",
    "build": "./build.sh",
    "dev": "python3 ipc_entry.py --browser --verbose",
    "test:tools": "node tests/design-tools.mjs",
    "test:dom": "node tests/tools-dom.mjs",
    "test:browser": "node tests/design-tools-browser.mjs",
    "test:creators": "node tests/creators.mjs",
    "test:creators:browser": "node tests/creators-browser.mjs",
    "test:creators:dom": "node tests/creators-dom.mjs",
    "test:families": "node tests/creator-families.mjs",
    "test:motor": "node tests/motor-layout.mjs && node tests/motor-families.mjs",
    "test:motor:dom": "node tests/motor-dom.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonahsaunders/planar-studio.git"
  },
  "keywords": [
    "kicad",
    "kicad-plugin",
    "pcb",
    "planar-inductor",
    "axial-flux",
    "pcb-motor",
    "rf-filter",
    "microstrip",
    "electromagnetics"
  ],
  "devDependencies": {
    "happy-dom": "20.14.0",
    "playwright": "1.62.1"
  }
}
